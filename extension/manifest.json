{
  "manifest_version": 3,
  "name": "saml2sts",
  "description": "Hands AWS SAML sign-ins to the saml2sts CLI.",
  "version": "0.1.0",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "permissions": [
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://signin.aws.amazon.com/saml",
    "https://*.signin.aws.amazon.com/saml"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "saml2sts@yokonao.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
